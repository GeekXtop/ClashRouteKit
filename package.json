{
  "name": "clash-route-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @clash-route-kit/web dev",
    "serve": "pnpm --filter @clash-route-kit/cli start serve",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "generate": "pnpm --filter @clash-route-kit/cli start generate",
    "preview": "pnpm --filter @clash-route-kit/cli start preview",
    "check": "pnpm --filter @clash-route-kit/cli start check",
    "sync:vendor": "pnpm --filter @clash-route-kit/cli start sync-vendor",
    "subconvert-url": "pnpm --filter @clash-route-kit/cli start subconvert-url"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}